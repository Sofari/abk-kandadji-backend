# =====================================================
# CONFIGURATION : Variables d'Environnement
# =====================================================
# Copier ce fichier à .env et remplir les valeurs

# ===== ENVIRONNEMENT =====
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ===== DATABASE PostgreSQL =====
# Format : postgresql://user:password@host:port/database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin123
DB_NAME=abk_kandadji

# Alternative : URL directe
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/abk_kandadji

# ===== AUTHENTIFICATION JWT =====
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-token-min-32-chars
JWT_REFRESH_EXPIRY=7d

# ===== BCRYPT =====
BCRYPT_ROUNDS=10

# ===== REDIS (pour les queues d'alertes) =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== EMAIL (Nodemailer) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@abk-kandadji.ne
SMTP_FROM_NAME=ABK Kandadji

# ===== SMS (Twilio - Optionnel) =====
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ===== STOCKAGE FICHIERS (Minio) =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=abk-kandadji
MINIO_USE_SSL=false

# ===== CORS =====
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# ===== API RATE LIMITING =====
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ===== FEATURES FLAGS =====
FEATURE_SMS_ALERTS=false
FEATURE_ADVANCED_SEARCH=true
FEATURE_EXPORT_EXCEL=true

# ===== LOGS =====
LOG_DIR=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d
